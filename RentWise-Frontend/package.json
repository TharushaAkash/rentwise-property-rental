{
  "name": "rentwise-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && node --test src/utils/*.test.js",
    "test:web": "vitest run --config tests/web-assessment/vitest.config.js",
    "test:web:e2e": "playwright test --config tests/web-assessment/playwright.config.js",
    "test:web:all": "npm run test:web && npm run test:web:e2e",
    "test:web:report": "playwright show-report tests/web-assessment/evidence/playwright-report",
    "test:web:live": "playwright test --config tests/web-assessment/playwright.live.config.js",
    "test:nf:compatibility": "playwright test --config tests/non-functional/playwright.config.js",
    "test:integration:workflows": "playwright test --config tests/integration-workflows/playwright.config.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "jsdom": "^30.1.2",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.3",
    "msw": "^2.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
